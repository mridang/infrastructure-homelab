{
  "name": "@mridang/homelab",
  "description": "Pulumi infrastructure for the homelab Kubernetes cluster",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "deploy": "pulumi up",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest --verbose --config=jest.config.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@mridang/eslint-defaults": "^2.7.0",
    "@pulumi/kubernetes": "^4.19.0",
    "@pulumi/pulumi": "^3.272.0",
    "@tsconfig/node20": "latest",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "jest": "^30.0.3",
    "jest-junit": "^17.0.0",
    "knip": "^6.45.1",
    "prettier": "^3.10.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "private": true,
  "workspaces": [
    "projects/*"
  ],
  "overrides": {
    "@eslint/core": "1.2.1"
  },
  "engines": {
    "node": ">=20"
  }
}
